[Unit]
Description=XGuard CLI client
Documentation=https://docs.xguard.local/
Wants=network-online.target
After=network-online.target

[Service]
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=/etc/xguard/dg.conf
ExecStart=/usr/sbin/dg
KillMode=process
KillSignal=SIGINT
LimitNOFILE=65536
LimitNPROC=infinity
Restart=on-failure
RestartSec=2
TasksMax=infinity
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
