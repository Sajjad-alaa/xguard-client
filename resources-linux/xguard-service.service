[Unit]
Description=XGuard interface daemon service
Documentation=https://docs.xguard.local
Wants=network-online.target
After=network-online.target

[Service]
Group=xguard
ExecReload=/bin/kill -HUP $MAINPID
ExecStart=/usr/sbin/xguard-service
KillMode=process
KillSignal=SIGINT
LimitNOFILE=65536
LimitNPROC=infinity
Restart=on-failure
RestartSec=2
TasksMax=infinity
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
