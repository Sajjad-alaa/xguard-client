<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="XGuardServiceFragment">
        <File KeyPath="yes" Id="XGuardServiceFile" Source="..\..\xguard-service.exe" />
        <ServiceInstall
          Account="LocalSystem"
          Id="XGuardService"
          Name="XGuardService"
          DisplayName="XGuard Service"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
        >
          <util:ServiceConfig
            ResetPeriodInDays="1"
            RestartServiceDelayInSeconds="30"
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
          />
        </ServiceInstall>
        <ServiceControl Id="XGuardService" Name="XGuardService" Start="install" Stop="both" Remove="uninstall" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
