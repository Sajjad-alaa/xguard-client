{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5072"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Defguard",
    "externalBin": [],
    "icon": [
      "icons/windows/32x32.png",
      "icons/windows/128x128.png",
      "icons/windows/128x128@2x.png",
      "icons/windows/icon.icns",
      "icons/windows/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "c79305cdcb7e5832dd161d18580d6a846bd0506b",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://time.certum.pl/",
      "wix": {
        "upgradeCode": "ce9f1855-fa79-44b6-8941-b09d083cf54d",
        "bannerPath": "./resources-windows/msi/top_banner.png",
        "dialogImagePath": "./resources-windows/msi/side_banner.png",
          "fragmentPaths": [
            "./resources-windows/fragments/service.wxs",
            "./resources-windows/fragments/provisioning.wxs"
          ],
          "componentRefs": [
            "XGuardServiceFragment",
            "ProvisioningScriptFragment"
          ],
        "template": "./resources-windows/msi/main.wxs"
      }
    },
    "resources": ["resources/icons/tray/*"],
    "shortDescription": "XGuard desktop client",
    "longDescription": "XGuard desktop client",
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/dg": "target/release/dg",
          "/usr/sbin/xguard-service": "target/release/xguard-service",
          "/usr/lib/systemd/system/xguard-service.service": "../resources-linux/xguard-service.service",
          "../control/rules": "../resources-linux/rules",
          "../control/postinst": "../resources-linux/postinst",
          "../control/prerm": "../resources-linux/prerm",
          "../control/postrm": "../resources-linux/postrm"
        },
        "depends": ["desktop-file-utils"]
      },
      "rpm": {
        "files": {
          "/usr/bin/dg": "target/release/dg",
          "/usr/sbin/xguard-service": "target/release/xguard-service",
          "/lib/systemd/system/xguard-service.service": "../resources-linux/xguard-service.service"
        },
        "depends": ["desktop-file-utils"],
        "postInstallScript": "../resources-linux/postinst",
        "preRemoveScript": "../resources-linux/prerm",
        "postRemoveScript": "../resources-linux/postrm"
      }
    }
  },
  "productName": "XGuard",
  "mainBinaryName": "xguard-client",
  "identifier": "local.xguard",
  "version": "2.2.0",
  "app": {
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xguard"]
      }
    }
  }
}
